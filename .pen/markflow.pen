                        {
                          "type": "text",
                          "id": "dropzoneIcon",
                          "name": "DropzoneIcon",
                          "fill": "$foregroundMuted",
                          "content": "📂",
                          "fontFamily": "Inter",
                          "fontSize": 28,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "dropzoneLabel",
