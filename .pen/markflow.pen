{
  "version": "2.13",
  "children": [
    {
      "type": "frame",
      "id": "mainWindow",
      "x": 100,
      "y": 100,
      "name": "MarkFlow - Main",
      "clip": true,
      "width": 1400,
      "height": 900,
      "fill": "$surface",
      "cornerRadius": 8,
      "layout": "vertical",
      "children": [
        {
          "type": "frame",
          "id": "titlebar",
          "name": "Titlebar",
          "width": "fill_container",
          "height": 40,
          "fill": "$surfaceSecondary",
          "stroke": "$border",
          "strokeWidth": {
            "bottom": 1
          },
          "gap": 8,
          "padding": [
            0,
            16
          ],
          "alignItems": "center",
          "children": [
            {
              "type": "rectangle",
              "cornerRadius": 4,
              "id": "logo",
              "name": "Logo",
              "fill": "$accent",
              "width": 20,
              "height": 20
            },
            {
              "type": "text",
              "id": "logoText",
              "name": "LogoText",
              "fill": "#FFFFFF",
              "content": "M",
              "fontFamily": "Inter",
              "fontSize": 10,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "appTitle",
              "name": "AppTitle",
              "fill": "$foregroundMuted",
              "content": "MarkFlow v0.1",
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "rectangle",
              "id": "titlebarSpacer",
              "name": "TitlebarSpacer",
              "opacity": 0,
              "width": "fill_container",
              "height": 1
            },
            {
              "type": "frame",
              "id": "themeBtn",
              "name": "ThemeBtn",
              "width": 28,
              "height": 28,
              "cornerRadius": 4,
              "stroke": "$border",
              "strokeWidth": 1,
              "justifyContent": "center",
              "alignItems": "center",
              "children": [
                {
                  "type": "text",
                  "id": "themeIcon",
                  "name": "ThemeIcon",
                  "fill": "$foregroundMuted",
                  "content": "☀",
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "windowControls",
              "name": "WindowControls",
              "layout": "horizontal",
              "gap": 4,
              "alignItems": "center",
              "children": [
                {
                  "type": "frame",
                  "id": "btnMinimize",
                  "name": "BtnMinimize",
                  "width": 28,
                  "height": 28,
                  "cornerRadius": 4,
                  "stroke": "$border",
                  "strokeWidth": 1,
                  "layout": "horizontal",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "minIcon",
                      "name": "MinIcon",
                      "content": "─",
                      "fontSize": 12,
                      "fill": "$foregroundMuted",
                      "fontFamily": "Inter"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "btnMaximize",
                  "name": "BtnMaximize",
                  "width": 28,
                  "height": 28,
                  "cornerRadius": 4,
                  "stroke": "$border",
                  "strokeWidth": 1,
                  "layout": "horizontal",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "maxIcon",
                      "name": "MaxIcon",
                      "content": "□",
                      "fontSize": 12,
                      "fill": "$foregroundMuted",
                      "fontFamily": "Inter"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "btnClose",
                  "name": "BtnClose",
                  "width": 28,
                  "height": 28,
                  "cornerRadius": 4,
                  "stroke": "$border",
                  "strokeWidth": 1,
                  "layout": "horizontal",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "closeIcon",
                      "name": "CloseIcon",
                      "content": "✕",
                      "fontSize": 12,
                      "fill": "$foregroundMuted",
                      "fontFamily": "Inter"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "mainContent",
          "name": "MainContent",
          "width": "fill_container",
          "height": "fill_container",
