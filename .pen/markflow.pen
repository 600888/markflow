              "alignItems": "center",
              "children": [
                {
                  "type": "text",
                  "id": "logBtnIcon",
                  "name": "LogBtnIcon",
                  "fill": "$foregroundMuted",
                  "content": "📋",
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
