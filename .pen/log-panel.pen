{
  "version": "2.13",
  "children": [
    {
      "type": "frame",
      "id": "logPanel",
      "name": "Log Panel",
      "x": 100,
      "y": 100,
      "clip": true,
      "width": 600,
      "height": 520,
      "fill": "#F2F3F0",
      "cornerRadius": 8,
      "layout": "vertical",
      "children": [
        {
          "type": "frame",
          "id": "logHeader",
          "name": "LogHeader",
          "width": "fill_container",
          "height": 44,
          "fill": "#E7E8E5",
          "stroke": "#CBCCC9",
          "strokeWidth": {"bottom": 1},
          "padding": [0, 16],
          "alignItems": "center",
          "gap": 8,
          "children": [
            {
              "type": "rectangle",
              "id": "headerSpacer",
              "name": "HeaderTitleSpacer",
              "width": "fill_container",
              "height": 1,
              "opacity": 0
            },
            {
              "type": "text",
              "id": "logTitle",
              "name": "LogTitle",
              "fill": "#111111",
              "content": "日志 / Log",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "600"
            },
            {
              "type": "frame",
              "id": "logCloseBtn2",
              "name": "LogCloseBtn",
              "width": 28,
              "height": 28,
              "cornerRadius": 4,
              "stroke": "#CBCCC9",
              "strokeWidth": 1,
              "justifyContent": "center",
              "alignItems": "center",
              "children": [
                {
                  "type": "text",
                  "id": "closeIcon2",
                  "name": "CloseIcon",
                  "fill": "#666666",
                  "content": "✕",
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
