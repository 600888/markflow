{
  "$schema": "https://raw.githubusercontent.com/nicarq/tauri-apps/main/tooling/cli/schema.json",
  "productName": "MarkFlow",
  "version": "0.1.0",
  "identifier": "com.markflow.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MarkFlow",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "center": true,
        "decorations": false,
        "backgroundColor": "#e5e7eb"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/markflow-service"],
    "resources": ["../data/**/*"]
  }
}
